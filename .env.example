# Required (Use localhost:5436 when running scripts directly on host machine, or db:5432 within Docker)
DATABASE_URL=postgresql+asyncpg://sisyphus:sisyphus@localhost:5436/sisyphus
FRONTEND_ORIGIN=http://localhost:3000

# Backend
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# Optional — AI Explanations (Gemini)
# GEMINI_API_KEY=your-gemini-api-key-here

# Optional — Phase 2+
# SESSION_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Test database (used by pytest)
TEST_DATABASE_URL=postgresql+asyncpg://sisyphus:sisyphus@localhost:5436/sisyphus_test

